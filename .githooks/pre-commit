#!/bin/sh
# Secret scan of staged changes. Enable once per clone:
#   git config core.hooksPath .githooks
set -e
root=$(git rev-parse --show-toplevel)
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks); refusing to commit." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --config "$root/.gitleaks.toml" "$root"
"$root/.githooks/check-denylist.sh" staged
